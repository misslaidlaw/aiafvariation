# Copy to .env for local use. Never commit .env.
# Visitors normally enter their own keys in the app's Settings panel.
# Server keys below are used as a fallback ONLY if ALLOW_SERVER_KEYS=true.
# Leave it false on any public deployment, or strangers will spend your credits.
ALLOW_SERVER_KEYS=false
ANTHROPIC_API_KEY=
PIKA_API_KEY=
PORT=3000
